# Sao chép file này thành .env rồi điền giá trị thật.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)

# Nhà cung cấp LLM: openrouter | deepseek | openai | anthropic | ollama | mock
#   mock = LLM giả lập (offline), chỉ dùng để kiểm tra pipeline, KHÔNG dùng cho kết quả thực nghiệm
LLM_PROVIDER=openrouter

# Tên model (bỏ trống để dùng mặc định của nhà cung cấp)
#   openrouter: z-ai/glm-5.2      deepseek: deepseek-chat
#   openai: gpt-4o-mini           anthropic: claude-haiku-4-5-20251001
#   ollama: qwen2.5-coder:7b
LLM_MODEL=z-ai/glm-5.2

# API key: chỉ cần điền key của nhà cung cấp đang dùng
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama chạy local (không cần key)
OLLAMA_BASE_URL=http://localhost:11434

# Tham số sinh
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000
LLM_TIMEOUT=180
LLM_MAX_RETRIES=3
